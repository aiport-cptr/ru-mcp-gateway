# Скопируйте в .env (chmod 600) и заполните. Шлюз НЕ стартует, если оставить заглушки.

# Внешний адрес (только https, без пути)
RUGW_PUBLIC_URL=https://mcp.your-company.ru

# Пароль PostgreSQL: openssl rand -base64 32
POSTGRES_PASSWORD=

# OAuth-приложение Яндекса (oauth.yandex.ru): права «Доступ к адресу почты» и «Доступ к логину»
# Redirect URI: https://mcp.your-company.ru/auth/yandex/callback
RUGW_YANDEX_CLIENT_ID=
RUGW_YANDEX_CLIENT_SECRET=

# Кого пускать (через запятую)
RUGW_ALLOWED_EMAIL_DOMAINS=your-company.ru
RUGW_ALLOWED_EMAILS=
# Кто при первом входе станет админом (точные адреса, не домены)
RUGW_BOOTSTRAP_ADMIN_EMAILS=
# Роль новых пользователей: readonly | member
RUGW_DEFAULT_ROLE=readonly

# --- Коннекторы: включаются, только если заданы учётные данные ---

# Яндекс Трекер: OAuth-токен сервисного пользователя, ID организации
RUGW_TRACKER_TOKEN=
RUGW_TRACKER_ORG_ID=
# 360 (X-Org-ID) или cloud (X-Cloud-Org-ID)
RUGW_TRACKER_ORG_KIND=360
# service — общий токен выше; user — от имени каждого сотрудника (нужны две настройки ниже)
RUGW_TRACKER_AUTH_MODE=service

# --- Доступ от имени сотрудника (только для RUGW_TRACKER_AUTH_MODE=user) ---
# Права должны быть включены в OAuth-приложении Яндекса
RUGW_YANDEX_EXTRA_SCOPES=
# Ключ Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Смена ключа: "новый,старый", затем rugw credentials rotate, затем убрать старый
RUGW_TOKEN_ENCRYPTION_KEYS=

# Битрикс24: входящий вебхук только с правами CRM
RUGW_BITRIX24_WEBHOOK_URL=

# 1С OData: отдельный пользователь 1С с правами только на чтение
RUGW_ONEC_ODATA_URL=
RUGW_ONEC_USERNAME=
RUGW_ONEC_PASSWORD=

# --- Обслуживание (значения по умолчанию разумны, менять не обязательно) ---
# Сколько дней хранить журнал аудита; 0 — бессрочно
RUGW_AUDIT_RETENTION_DAYS=365
# Ограничение частоты запросов (в минуту)
RUGW_RATE_LIMIT_ENABLED=true
RUGW_RATE_REGISTER_PER_MINUTE=10
RUGW_RATE_AUTH_PER_MINUTE=30
RUGW_RATE_MCP_PER_MINUTE=300
# Прокси, которым верим в X-Forwarded-For. По умолчанию — localhost и сети Docker
RUGW_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
