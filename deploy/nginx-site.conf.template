# nginx: шлюз ru-mcp-gateway на поддомене __DOMAIN__.
# Готовый файл с подставленными значениями пишет deploy/install.sh в deploy/generated/.
#
# 1) Сначала сертификат (certbot должен быть установлен):
#      sudo certbot certonly --nginx -d __DOMAIN__
# 2) Скопируйте файл в /etc/nginx/sites-available/, включите и проверьте:
#      sudo ln -s /etc/nginx/sites-available/rugw-__DOMAIN__.conf /etc/nginx/sites-enabled/
#      sudo nginx -t && sudo systemctl reload nginx
# Другие сайты сервера этот файл не затрагивает.

# Формат журнала без строки запроса ($uri вместо $request): в адресах OAuth бывают одноразовые коды.
log_format rugw_noquery___PORT__ '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 80;
    server_name __DOMAIN__;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    server_tokens off;

    access_log /var/log/nginx/rugw-__DOMAIN__.access.log rugw_noquery___PORT__;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # MCP (Streamable HTTP) держит поток ответа открытым
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
